{
  "name": "@elafo/pi-better-snippets",
  "version": "0.3.0",
  "private": false,
  "packageManager": "npm@11.19.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Previews syntax-highlighted fenced snippets and copies them individually from Pi assistant responses.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "snippets",
    "clipboard"
  ],
  "license": "MIT",
  "author": {
    "name": "eLafo"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eLafo/pi-better-snippets.git"
  },
  "bugs": {
    "url": "https://github.com/eLafo/pi-better-snippets/issues"
  },
  "homepage": "https://github.com/eLafo/pi-better-snippets#readme",
  "files": [
    "index.ts",
    "src",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/eLafo/pi-better-snippets/main/assets/pi-better-snippets-preview.png",
    "video": "https://raw.githubusercontent.com/eLafo/pi-better-snippets/main/assets/pi-better-snippets-demo.mp4"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.thresholds.lines=95 --coverage.thresholds.functions=90 --coverage.thresholds.branches=80 --coverage.thresholds.statements=90",
    "typecheck": "tsc --noEmit",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:lifecycle": "node scripts/verify-lifecycle.mjs",
    "verify:actions": "node scripts/verify-actions.mjs",
    "audit:production": "node scripts/verify-audit.mjs production",
    "audit:full": "node scripts/verify-audit.mjs full",
    "smoke:no-dev": "node scripts/no-dev-smoke.mjs",
    "host:load": "vitest run test/host-mode.test.ts",
    "check": "npm run test:verifiers && npm run typecheck && npm run test:coverage && npm run verify:package && npm run verify:lifecycle && npm run verify:actions && npm run audit:production && npm run audit:full",
    "test:verify-actions": "node scripts/test-verify-actions.mjs",
    "test:verifiers": "npm run test:verify-actions && npm run test:verify-lifecycle && npm run test:verify-audit",
    "test:verify-lifecycle": "node scripts/test-verify-lifecycle.mjs",
    "test:verify-audit": "node scripts/test-verify-audit.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "22.19.19",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
